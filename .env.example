VITE_ADVISOR_API_URL=/api/advisor
# Use the Beijing workspace API key that owns the deployed fine-tuned model.
QWEN_API_KEY=your-bailian-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Deployment code; the training output ID is not the invocation code.
QWEN_MODEL=qwen3-8b-01fa13690bf1
# Planner understands the student question before catalogue search. Defaults to qwen-plus.
# QWEN_PLANNER_MODEL=qwen-plus
# Optional: finetune-only shows raw single-question output; integrated restores course cards.
QWEN_ADVISOR_MODE=integrated
QWEN_ASR_MODEL=qwen3-asr-flash
# Live catalogue for advisor answers. Leave empty only for offline snapshot tests.
SUPABASE_URL=
SUPABASE_ANON_KEY=
