# Same-origin authenticated advisor. No key: local knowledge retrieval.
VITE_ADVISOR_API_URL=/api/advisor

# Qwen (DashScope compatible-mode) enables LLM answers grounded in retrieved sources.
# Never commit a real key. Guests and members use this path when the key is set.
# QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3-8b-01fa13690bf1
# QWEN_PLANNER_MODEL=qwen-plus
QWEN_ASR_MODEL=qwen3-asr-flash
# Optional yucan fine-tune path: finetune-only shows raw output; integrated restores course cards.
QWEN_ADVISOR_MODE=integrated

# DeepSeek is an alternate LLM. Qwen is used when both are set.
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash

# Local account and profile database (requires Node.js 24 or later).
AUTH_DATABASE_PATH=./data/polypath.sqlite
# npm run dev creates the public team demo account if absent. Set false to skip.
AUTH_SEED_TEST_ACCOUNT=true
# Set true when serving through HTTPS, including a TLS reverse proxy.
AUTH_SECURE_COOKIES=false
# Optional public origin, for example https://polypath.example.com (no trailing slash).
# AUTH_ORIGIN=

# Supabase connection settings (server-only). Accepts publishable or legacy anon keys.
# Connecting does not migrate SQLite data or change the active storage provider.
# public.courses is read at server start and merged into advisor retrieval.
# Account/profile/chat storage remains in local SQLite. Never use a service-role key.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY= # Alternate name accepted for the same public key.
