# Same-origin authenticated advisor. No key: local knowledge retrieval.
VITE_ADVISOR_API_URL=/api/advisor

# DeepSeek enables LLM answers grounded in retrieved sources. Never commit a real key.
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash

# Local account and profile database (requires Node.js 24 or later).
AUTH_DATABASE_PATH=./data/polypath.sqlite
# Set true when serving through HTTPS, including a TLS reverse proxy.
AUTH_SECURE_COOKIES=false
# Optional public origin, for example https://polypath.example.com (no trailing slash).
# AUTH_ORIGIN=

# Supabase connection settings (server-only). Accepts publishable or legacy anon keys.
# Connecting does not migrate SQLite data or change the active storage provider.
# Cloud access is read-only; account/profile/chat storage remains in local SQLite.
# Read-only table mappings are not enabled in the application yet.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY= # Alternate name accepted for the same public key.
